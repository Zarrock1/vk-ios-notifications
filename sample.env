# Токен пользователя VK с правами messages,offline (см. README → «Как получить токен VK»)
VK_TOKEN=vk1.a.*****

# Ключ устройства из приложения Bark. Можно вставить ссылку целиком: https://api.day.app/AbCdEf/
BARK_TOKEN=AH********
BARK_URL=https://api.day.app

# Необязательные настройки
# BARK_SOUND=minuet
# BARK_LEVEL=active                 # active | timeSensitive | passive | critical
# BARK_GROUP_BY_DIALOG=true         # группировать уведомления по диалогам
# READ_CHECK_DELAY=2                # пауза перед проверкой «уже прочитано», 0 — отключить
# NOTIFY_STARTUP=true               # уведомление при запуске сервиса
